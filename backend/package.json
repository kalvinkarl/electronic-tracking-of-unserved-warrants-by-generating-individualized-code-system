{
  "name": "etugis-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.0",
    "argon2": "^0.41.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.1",
    "@types/argon2": "^0.15.4",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}